# Example .env
# Puerto en el que corre la API
PORT=3000

# URL de conexión a PostgreSQL (formato):
# postgres://<user>:<password>@<host>:<port>/<database>
# Opciones comunes:
# - Postgres local con usuario 'postgres' y contraseña 'postgres':
#   postgres://postgres:postgres@localhost:5432/fhldb
# - Si usas Docker Compose y el servicio se llama 'db' usa host 'db':
#   postgres://postgres:postgres@db:5432/fhldb
# - Si tu instalación local no requiere contraseña (peer auth):
#   postgres://postgres@localhost:5432/fhldb
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fhldb

# Secreto para JWT (cámbialo en producción)
JWT_SECRET=supersecretkey
